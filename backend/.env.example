# Development placeholders only. Never use these credentials in production.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://stoppy:local-development-only@127.0.0.1:5433/stoppy
# Production requires verify-full and a trusted PostgreSQL TLS certificate.
DATABASE_SSL=disable
# Use a stable Ed25519 PKCS#8 private key supplied by your secret manager.
# Literal \n sequences in AUTH_PRIVATE_KEY are decoded to newlines.
# When omitted in development/test only, a process-local ephemeral key is used.
# AUTH_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
AUTH_ISSUER=stoppy-local
AUTH_AUDIENCE=stoppy-app-local
# Temporary access lifetime until protected Flutter requests support renewal.
AUTH_ACCESS_SECONDS=86400
AUTH_REFRESH_SECONDS=2592000
# Optional: a separate disposable database for the explicitly invoked DB tests.
# TEST_DATABASE_URL=postgresql://stoppy:local-development-only@127.0.0.1:5433/stoppy_test
